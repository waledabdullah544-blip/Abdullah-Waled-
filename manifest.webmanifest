{
  "name": "Masar",
  "short_name": "Masar",
  "description": "Masar: professional vector design.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#323232",
  "theme_color": "#323232",
  "icons": [
    { "src": "icons/masar-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/masar-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/masar-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/masar.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "/", "accept": { "application/x-masar": [".masar"], "image/svg+xml": [".svg"] } }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
